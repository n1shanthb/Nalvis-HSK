{
  "name": "nalvis-hsk",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "lint": "pnpm -r lint && tsc -b --noEmit",
    "dev": "pnpm --filter @nalvis/dashboard dev",
    "keeper": "node packages/keeper/dist/keeper/src/cli.js",
    "verify": "node packages/verifier/dist/verifier/src/cli.js",
    "nalvis": "node scripts/nalvis.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.18.0",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "^9.39.0",
    "prettier": "^3.6.2",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  },
  "bin": {
    "nalvis": "scripts/nalvis.mjs"
  }
}

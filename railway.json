{
  "$schema": "https://railway.com/railway.schema.json",
  "build": { "builder": "DOCKERFILE", "dockerfilePath": "deploy/agent/Dockerfile" },
  "deploy": {
    "startCommand": "node packages/keeper/dist/keeper/src/cli.js agent --exec testnet",
    "healthcheckPath": "/healthz",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}

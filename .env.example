# local machine only, never commit values
HSK_MAINNET_RPC=
HSK_TESTNET_RPC=
FORK_BLOCK_177=
TESTNET_DEPLOYER_KEY=
TESTNET_AGENT_KEY=
OWNER_ADDRESS=
LLM_API_KEY=

# Dashboard AI (server-only; never prefix these with VITE_)
# Configure a production model supported by your provider account.
GROQ_API_KEY=
GROQ_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Set false to disable both hosted providers immediately.
DESK_AI_ENABLED=false

# T12 agent library: dedicated server-only key; never uses the dashboard key.
AGENT_OPENROUTER_API_KEY=
# Example: STRATEGIST_MODEL=anthropic/claude-haiku-5.5
STRATEGIST_MODEL=
# Empty FITTER_MODEL defaults to STRATEGIST_MODEL.
# Example: FITTER_MODEL=xiaomi/mimo-v2.6-flash
FITTER_MODEL=
OPENROUTER_APP_URL=
OPENROUTER_APP_NAME=
AGENT_MODE=agent
AGENT_HEARTBEAT_SEC=3600
AGENT_POLL_SEC=20
AGENT_MIN_WAKE_GAP_SEC=60
# Wake cap example: AGENT_MAX_WAKES_PER_HOUR=12
AGENT_MAX_WAKES_PER_HOUR=12
# Daily budget example: AGENT_DAILY_LLM_BUDGET_USD=1.00
AGENT_DAILY_LLM_BUDGET_USD=1.00
AGENT_FIT_ROUNDS=3
AGENT_ANCHOR_SEC=7200

# Shared AI budget (required before enabling providers; server-only placeholders)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# At least 32 random characters; shared by all instances, never rotate to reset credits.
DESK_IP_HASH_SECRET=
DESK_AI_IP_PER_MINUTE=5
DESK_AI_GLOBAL_PER_MINUTE=30
DESK_AI_IP_DAILY_CREDITS=20
DESK_AI_GLOBAL_DAILY_CAP=200

# Copy to contracts/.env. This file contains placeholders only.
# Never put private keys, seed phrases, or wallet passwords in either file.

# Network
HSK_TESTNET_RPC=https://testnet.hsk.xyz
HSK_MAINNET_RPC=https://mainnet.hsk.xyz
FORK_BLOCK_177=29413000

# Public addresses only; owner starts as the temporary deployment owner.
# It must be transferred to Nishanth's verified Ledger after deployment.
OWNER_ADDRESS=0x82437E9Bb58cFf40B996818CCcdF1523fC5cE927
AGENT_ADDRESS=REPLACE_WITH_TESTNET_AGENT_ADDRESS
DEPLOYER_ADDRESS=REPLACE_WITH_TESTNET_DEPLOYER_ADDRESS

# Deployment
DEPLOY_COMMIT=REPLACE_WITH_40_CHARACTER_LOWERCASE_GIT_COMMIT
TWAP_WINDOW_SEC=600

# Mandate / execution
MAX_DRAWDOWN_BPS=2000
VAULT_ADDRESS=REPLACE_WITH_VERIFIED_TESTNET_VAULT_ADDRESS

# Token and protocol addresses are fixed in contracts/script/Addresses.sol;
# see docs/ADDRESSES.md. They are not read from this env file.
# Mandate caps, expiry, and bootstrap funding amounts are fixed in the existing
# calldata helper and scripts/testnet-bootstrap.md.
